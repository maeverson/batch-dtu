# Copie para .env e ajuste o que precisar. Valores são de DESENVOLVIMENTO.
# Nenhum segredo real entra aqui — em produção tudo vem do vault (invariante 5).

# --- Postgres (catálogo, execuções, auditoria) -------------------------------
POSTGRES_DB=batch_catalog
POSTGRES_USER=batch
POSTGRES_PASSWORD=batch_dev
POSTGRES_PORT=5432

# URL usada pela aplicação e pelo Alembic.
# A role `batch_app` é criada pelo init do banco e NÃO tem UPDATE/DELETE nas
# tabelas append-only — é de propósito, para o teste de imutabilidade valer algo.
DATABASE_URL=postgresql+psycopg://batch_app:batch_app_dev@localhost:5432/batch_catalog
DATABASE_URL_MIGRATIONS=postgresql+psycopg://batch_migrator:batch_migrator_dev@localhost:5432/batch_catalog
DATABASE_URL_TEST=postgresql+psycopg://batch_migrator:batch_migrator_dev@localhost:5432/batch_catalog_test

# --- Observabilidade ---------------------------------------------------------
LOKI_PORT=3100
LOKI_URL=http://localhost:3100
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin
PROMETHEUS_PORT=9090
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# --- Identidade (stand-in do Entra ID) --------------------------------------
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_PASSWORD=admin
OIDC_ISSUER=http://localhost:8080/realms/batch-dtu
OIDC_AUDIENCE=platform-api
OIDC_CLIENT_ID=platform-api
OIDC_CLIENT_SECRET=platform-api-dev-secret

# --- Host legado simulado (backend SSH da Fase 1) ---------------------------
# Dono da chave gerada em docker/legacy/keys/ — ajuste se seu usuário não for 1000
# (`id -u` / `id -g`), senão a Platform API no host não consegue ler a chave.
KEYS_UID=1000
KEYS_GID=1000
LEGACY_SSH_PORT=2222
LEGACY_SSH_HOST=localhost
LEGACY_SSH_USER=backoffice_svc
LEGACY_SSH_KEY=./docker/legacy/keys/backoffice_svc_ed25519
LEGACY_FW_ROOT=/opt2/batch_v2/batch-commons-framework
# Contratos servidos pelo host legado simulado. Default: os 4 fixtures sintéticos
# da imagem — que NÃO existem no catálogo, então executar um job real pela UI
# falha na pré-validação ("contrato não encontrado"). Para exercitar jobs reais,
# aponte para o framework/processes de um pacote de coleta:
#   LEGACY_PROCESSES_DIR=./seed/raw/batch-seed-srv-sftp-2-<stamp>/framework/processes
# Atenção: esse conteúdo é de cliente real (nome, caminho interno) — por isso
# seed/raw/ é gitignored. Uso local, nunca em imagem publicada.
#LEGACY_PROCESSES_DIR=

# --- Armazenamento (destinos de download/upload) -----------------------------
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_USER=batch
MINIO_PASSWORD=batch_dev_secret
SFTP_PORT=2223
SFTP_USERS=cliente_teste:cliente_teste:1001

# --- Vault (dev) -------------------------------------------------------------
VAULT_PORT=8200
VAULT_TOKEN=batch-dev-root
VAULT_ADDR=http://localhost:8200
