# Copie para .env.local (Vite ignora .env.local no git automaticamente).
# Valores default = ambiente de desenvolvimento (docker-compose.yaml raiz).

# Platform API (src/platform_api) — sobe em :8000 (`platform-api`, no venv Python).
VITE_API_BASE_URL=http://localhost:8000

# Keycloak local, stand-in do Entra ID (docker/keycloak/realm-batch-dtu.json).
# Cliente "back-office": público, PKCE, sem client secret (SPA).
VITE_OIDC_AUTHORITY=http://localhost:8080/realms/batch-dtu
VITE_OIDC_CLIENT_ID=back-office
VITE_OIDC_REDIRECT_URI=http://localhost:5173/callback
# Escopo pedido no login. No Keycloak local o default basta. No Entra ID é
# OBRIGATÓRIO incluir o escopo da API, senão o token sai com audiência do
# Microsoft Graph e a Platform API devolve 401 em tudo:
#   VITE_OIDC_SCOPE="openid profile email api://<client-id-da-api>/access_as_user"
VITE_OIDC_SCOPE=openid profile email
