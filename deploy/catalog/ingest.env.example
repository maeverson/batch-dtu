# Carga do catálogo (`catalog ingest-processes` / `catalog load`).
#
# Roda como Job/CronJob, não como serviço: sobe com estas variáveis, carrega e
# morre. Usa a role de MIGRAÇÃO quando precisa escrever em tabela append-only
# via trigger; `--role app` basta para a carga normal.
#
#   set -a; . deploy/catalog/ingest.env; set +a
#   catalog ingest-processes /opt2/batch_v2/batch-commons-framework/processes/base2 \
#     --host srv-sftp-2 --environment PROD --actor <voce>@contabilizei.com.br

DATABASE_URL=postgresql+psycopg://batch_app:__DO_SECRETS_MANAGER__@<rds-endpoint>:5432/batch_catalog
DATABASE_URL_MIGRATIONS=postgresql+psycopg://batch_migrator:__DO_SECRETS_MANAGER__@<rds-endpoint>:5432/batch_catalog
