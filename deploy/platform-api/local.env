# Platform API — ambiente LOCAL (docker-compose.yaml deste repositório).
#
#   docker compose --profile auth --profile legacy up -d
#   set -a; . deploy/platform-api/local.env; set +a
#   platform-api
#
# Único arquivo desta pasta com valores de verdade, porque nenhum deles existe
# fora da sua máquina: Keycloak local, host legado SIMULADO, Postgres de dev.

PLATFORM_ENVIRONMENT=UAT
PLATFORM_HOST=srv-sftp-2

DATABASE_URL=postgresql+psycopg://batch_app:batch_app_dev@localhost:5432/batch_catalog
PLATFORM_API_DB_ROLE=app

# Keycloak do compose — stand-in do Entra ID, só aqui.
OIDC_ISSUER=http://localhost:8080/realms/batch-dtu
OIDC_AUDIENCE=platform-api
OIDC_ROLES_CLAIM=realm_access.roles
OIDC_SUBJECT_CLAIM=preferred_username

SSH_BACKEND_HOST=localhost
SSH_BACKEND_PORT=2222
SSH_BACKEND_USER=backoffice_svc
SSH_BACKEND_KEY=docker/legacy/keys/backoffice_svc_ed25519
# A chave do container `legacy` muda a cada rebuild — este é o ÚNICO lugar
# onde pular a verificação é aceitável, e ela tem nome justamente para
# aparecer em revisão se alguém copiar isto para um manifesto de verdade.
SSH_BACKEND_ALLOW_UNKNOWN_HOSTS=true

# Observabilidade local continua Loki/Grafana do compose.
LOG_BACKEND=loki
LOKI_URL=http://localhost:3100
NEW_RELIC_ENABLED=false

CORS_ALLOW_ORIGINS=http://localhost:5173,http://localhost:3001
