# Platform API — UAT (Batch-DTU / com-ins-bch-mdw-dtu-1 / 172.21.86.76).
# Copie para um Secret/ConfigMap do deploy. Valores de segredo NÃO entram aqui.

# --- Escopo do deploy: esta instância serve UM ambiente e UM host ------------
PLATFORM_ENVIRONMENT=UAT
PLATFORM_HOST=com-ins-bch-mdw-dtu-1

# --- Banco (RDS PostgreSQL) --------------------------------------------------
# Valor real vem do Secrets Manager; a role `batch_app` não tem UPDATE/DELETE
# nas tabelas append-only, e é de propósito.
DATABASE_URL=postgresql+psycopg://batch_app:__DO_SECRETS_MANAGER__@<rds-endpoint>:5432/batch_catalog
PLATFORM_API_DB_ROLE=app

# --- Identidade: Entra ID ----------------------------------------------------
OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
OIDC_AUDIENCE=<client-id-da-app-registration-da-api>
OIDC_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
OIDC_ROLES_CLAIM=roles
# `oid` é o GUID imutável do usuário no tenant. `preferred_username`/`upn`
# mudam (casamento, troca de sobrenome, migração de domínio) e a trilha de
# auditoria passaria a apontar para alguém que "não existe".
OIDC_SUBJECT_CLAIM=oid
OIDC_DISPLAY_NAME_CLAIM=preferred_username

# --- Host do main.sh (relação de confiança SSH) ------------------------------
SSH_BACKEND_HOST=172.21.86.76
SSH_BACKEND_PORT=22
SSH_BACKEND_USER=backoffice_svc
# Arquivo montado do vault, 0600, dono = usuário do processo. NUNCA a chave.
SSH_BACKEND_KEY=/var/run/secrets/batch/backoffice_svc_ed25519
# Verificação da chave do host. Sem isto o processo se recusa a subir.
SSH_BACKEND_KNOWN_HOSTS=/etc/batch/known_hosts
SSH_BACKEND_TIMEOUT=15

# --- Observabilidade: New Relic ---------------------------------------------
NEW_RELIC_ENABLED=true
NEW_RELIC_APP_NAME=batch-dtu-platform-api (UAT)
NEW_RELIC_LICENSE_KEY=__DO_SECRETS_MANAGER__
NEW_RELIC_ACCOUNT_ID=<account-id>
NEW_RELIC_API_KEY=__DO_SECRETS_MANAGER__
NEW_RELIC_NERDGRAPH_URL=https://api.newrelic.com/graphql
NEW_RELIC_CONFIG_FILE=/etc/newrelic/newrelic.ini
LOG_BACKEND=newrelic

# --- Back Office -------------------------------------------------------------
CORS_ALLOW_ORIGINS=https://batch-uat.<dominio-interno>
