# Back Office (SPA) — PROD. ATENÇÃO: Vite embute estas variáveis em BUILD TIME.
# Trocar o arquivo depois do build não tem efeito nenhum — é preciso rebuildar.
#
#   cp deploy/back-office/prod.env.example frontend/.env.production.local
#   cd frontend && npm ci && npm run build

VITE_API_BASE_URL=https://batch-api.<dominio-interno>

# Entra ID — app registration da SPA (pública, PKCE, sem client secret).
VITE_OIDC_AUTHORITY=https://login.microsoftonline.com/<tenant-id>/v2.0
VITE_OIDC_CLIENT_ID=<client-id-da-spa>
VITE_OIDC_REDIRECT_URI=https://batch.<dominio-interno>/callback

# OBRIGATÓRIO no Entra: sem o escopo da API, o access token sai com audiência
# do Microsoft Graph e a Platform API recusa TUDO com 401 — com o login
# funcionando normalmente, que é o que torna esse erro caro de diagnosticar.
VITE_OIDC_SCOPE=openid profile email api://<client-id-da-api>/access_as_user
