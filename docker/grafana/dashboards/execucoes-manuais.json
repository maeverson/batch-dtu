{
  "uid": "batch-execucoes-manuais",
  "title": "Execuções manuais",
  "description": "Painel de execuções manuais e reprocessos disparados pela Platform API (observability, Etapa 1.3). Fonte: catalog.execution/catalog.job — a mesma tabela que gera o audit_event. Para o log de uma execução específica, copie o execution_id da tabela e abra GET /executions/{execution_id}/logs ou o Explore com {execution_id=\"...\"}.",
  "tags": ["batch-dtu", "fase-1", "execucoes"],
  "timezone": "utc",
  "editable": true,
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": { "from": "now-24h", "to": "now" },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Execuções manuais (período)",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Execuções\"\nFROM catalog.execution e\nWHERE e.trigger IN ('manual','reprocess')\n  AND $__timeFilter(e.started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": { "color": { "mode": "thresholds" }, "unit": "none" },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Em execução agora",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Em execução\"\nFROM catalog.execution e\nWHERE e.trigger IN ('manual','reprocess') AND e.status = 'running'"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "text", "value": null },
              { "color": "blue", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Falhas (período)",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT count(*) AS \"Falhas\"\nFROM catalog.execution e\nWHERE e.trigger IN ('manual','reprocess')\n  AND e.status = 'failed'\n  AND $__timeFilter(e.started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "none",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "red", "value": 1 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Taxa de sucesso (período)",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 0 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  CASE WHEN count(*) FILTER (WHERE e.status IN ('succeeded','failed')) = 0 THEN NULL\n       ELSE round(100.0 * count(*) FILTER (WHERE e.status = 'succeeded')\n            / count(*) FILTER (WHERE e.status IN ('succeeded','failed')), 1)\n  END AS \"Sucesso\"\nFROM catalog.execution e\nWHERE e.trigger IN ('manual','reprocess')\n  AND $__timeFilter(e.started_at)"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "unit": "percent",
          "min": 0,
          "max": 100,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "yellow", "value": 80 },
              { "color": "green", "value": 98 }
            ]
          }
        },
        "overrides": []
      },
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "value", "graphMode": "none" }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Execuções manuais por hora, por status",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 4 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "time_series",
          "rawSql": "SELECT\n  date_trunc('hour', e.started_at) AS time,\n  e.status,\n  count(*) AS execucoes\nFROM catalog.execution e\nWHERE e.trigger IN ('manual','reprocess')\n  AND $__timeFilter(e.started_at)\nGROUP BY 1, 2\nORDER BY 1"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "drawStyle": "bars", "stacking": { "mode": "normal", "group": "A" } }, "unit": "none" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "succeeded" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "green" } }] },
          { "matcher": { "id": "byName", "options": "failed" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "red" } }] },
          { "matcher": { "id": "byName", "options": "running" }, "properties": [{ "id": "color", "value": { "mode": "fixed", "fixedColor": "blue" } }] }
        ]
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" }, "tooltip": { "mode": "multi" } }
    },
    {
      "id": 6,
      "type": "table",
      "title": "Últimas execuções manuais",
      "description": "execution_id é a chave de correlação com o log em Loki (label do stream, ver docker/promtail/config.yaml) e com o audit_event.",
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 12 },
      "datasource": { "type": "postgres", "uid": "postgres" },
      "targets": [
        {
          "refId": "A",
          "format": "table",
          "rawSql": "SELECT\n  e.started_at AS \"Início\",\n  j.process_name AS \"Processo\",\n  j.domain AS \"Domínio\",\n  j.environment AS \"Ambiente\",\n  j.host AS \"Host\",\n  e.trigger AS \"Tipo\",\n  e.status AS \"Status\",\n  e.result AS \"Resultado\",\n  e.requested_by AS \"Solicitante\",\n  e.justification AS \"Justificativa\",\n  round(EXTRACT(EPOCH FROM (COALESCE(e.ended_at, now()) - e.started_at))) AS \"Duração (s)\",\n  e.id AS \"execution_id\"\nFROM catalog.execution e\nJOIN catalog.job j ON j.id = e.job_id\nWHERE e.trigger IN ('manual','reprocess')\n  AND $__timeFilter(e.started_at)\nORDER BY e.started_at DESC\nLIMIT 200"
        }
      ],
      "fieldConfig": {
        "defaults": { "custom": { "align": "left" } },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "Status" },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": { "type": "color-text" }
              },
              {
                "id": "mappings",
                "value": [
                  { "type": "value", "options": { "succeeded": { "color": "green" }, "failed": { "color": "red" }, "running": { "color": "blue" }, "queued": { "color": "text" }, "cancelled": { "color": "orange" } } }
                ]
              }
            ]
          }
        ]
      },
      "options": { "showHeader": true, "sortBy": [{ "displayName": "Início", "desc": true }] }
    }
  ]
}
